# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Connection URI (MongoDB Atlas cluster connection string)
MONGODB_URI=

# JWT Secret for Admin dashboard authentication tokens
JWT_SECRET=enterpriseceo-masterclass-jwt-secret-key-2026

# Resend API Key for sending transactional emails
RESEND_API_KEY=

# Verified sender email address in Resend (e.g. masterclass@enterpriseceo.africa or onboarding@resend.dev)
SENDING_EMAIL_ADDRESS=masterclass@enterpriseceo.africa

# Admin notification email recipients (comma-separated)
ADMIN_NOTIFICATION_EMAILS=hello@enterpriseceo.africa

# Allowed CORS origins (optional, comma-separated)
CORS_ALLOWED_ORIGINS=

# Initial Admin User credentials (seeded automatically if no admin exists)
ADMIN_INITIAL_EMAIL=admin@enterpriseceo.africa
ADMIN_INITIAL_PASSWORD=EnterpriseCEO2026!

# Paystack Payment Gateway Integration
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_SECRET_KEY=
PAYSTACK_AMOUNT_NAIRA=250000
